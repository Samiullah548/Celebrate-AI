# ─── CelebrateAI Environment Variables ─────────────────────────────────────────

# Required: Google Gemini API key
# Get yours at: https://aistudio.google.com/app/apikey
# In Vercel: Set this in Project Settings > Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (default: gemini-3.5-flash)
# Supported fast models: gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.6-flash
GEMINI_MODEL=gemini-3.5-flash

# Optional: Port for local Express server (default: 5000)
PORT=5000

# Optional: Allowed origins for standalone Express server (server/server.js)
CLIENT_URL=http://localhost:5173

# Frontend API base URL:
# Leave EMPTY when deployed on Vercel (same-origin /api serverless functions)
# Only set if hosting backend on an external server (e.g. Railway or Render)
VITE_API_URL=

# ─── Backend (server/.env or root .env) ──────────────────────────────────────

# Required: Google Gemini API key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Gemini model to use (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Port for the Express backend (default: 5000)
PORT=5000

# Allowed frontend origin(s) — comma-separated for multiple
# Development: http://localhost:5173
# Production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ─── Frontend (root .env or .env.local) ──────────────────────────────────────

# Leave empty for development (Vite proxy handles /api → localhost:5000)
# Production: set to your hosted backend URL (no trailing slash)
# Example: https://celebrateai-api.railway.app
VITE_API_URL=
